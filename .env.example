# Copy to .env and fill in. Never commit .env.
CFAIOS_NEO4J_URI=bolt://localhost:7687
CFAIOS_NEO4J_USER=neo4j
CFAIOS_NEO4J_PASSWORD=change-me
CFAIOS_VECTOR_BACKEND=pgvector
CFAIOS_VECTOR_DSN=postgresql://user:pass@localhost:5432/cfaios
CFAIOS_ANTHROPIC_API_KEY=sk-ant-...
CFAIOS_ANTHROPIC_MODEL=claude-opus-4-8
CFAIOS_GOOGLE_API_KEY=...
CFAIOS_GOOGLE_MODEL=gemini-3.1-flash-lite
CFAIOS_GROQ_API_KEY=gsk_...
CFAIOS_GROQ_MODEL=llama-3.3-70b-versatile
CFAIOS_STOCKFISH_PATH=/usr/bin/stockfish
CFAIOS_SYZYGY_PATH=
